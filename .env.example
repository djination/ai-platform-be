SECRET_KEY=replace-with-django-secret-key
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost

DB_ENGINE=django.db.backends.postgresql
DB_NAME=replace-with-db-name
DB_USER=replace-with-db-user
DB_PASSWORD=replace-with-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

OPENCLAW_API_KEY=replace-with-openclaw-api-key
OPENCLAW_INGEST_THROTTLE_RATE=30/minute

# Learner chat (Phase 2). Leave OPENROUTER_API_KEY empty to use safe baseline replies in dev.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
CHAT_THROTTLE_RATE=60/hour
CHAT_DAILY_MESSAGE_LIMIT=200
# Kuota chat harian per tier berbayar (0 = tanpa batas harian untuk tier itu).
CHAT_GO_DAILY_MESSAGE_LIMIT=400
CHAT_PLUS_DAILY_MESSAGE_LIMIT=2000
CHAT_PRO_DAILY_MESSAGE_LIMIT=0
# Kuota akses konten/modul harian per tier (0 = tanpa batas harian untuk tier itu).
CONTENT_DAILY_LIMIT=5
CONTENT_GO_DAILY_LIMIT=15
CONTENT_PLUS_DAILY_LIMIT=50
CONTENT_PRO_DAILY_LIMIT=0

# Demo: simulasi sukses bayar (matikan di production).
BILLING_DEMO_PAYMENT_ENABLED=false
# BILLING_DEMO_SUBSCRIPTION_DAYS=30
# BILLING_DEMO_THROTTLE_RATE=30/hour
# BILLING_MANAGE_THROTTLE_RATE=30/hour
# Reuse identical first-turn chat replies from DB (no session history) to save LLM tokens
CHAT_REPLY_CACHE_ENABLED=true


# Google reCAPTCHA: if RECAPTCHA_SECRET_KEY is set, register requires recaptcha_token.
# Set RECAPTCHA_VERIFY_LOGIN=true to also require token on POST /api/auth/token/ (login).
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_VERIFY_LOGIN=false
# LEARNER_LOGIN_THROTTLE_RATE=30/hour
# LEARNER_REGISTER_THROTTLE_RATE=20/hour

# Admin discovery (search + extract + ingest).
# Backends: duckduckgo | google | serpapi (set DISCOVERY_SEARCH_BACKEND or choose in Admin UI).
DISCOVERY_SEARCH_BACKEND=duckduckgo
DISCOVERY_MAX_RESULTS_CAP=15
DISCOVERY_INGEST_THROTTLE_RATE=12/hour
# Google Custom Search JSON API: enable "Custom Search API" in Google Cloud + create Programmable Search Engine.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
# Optional: same key as GOOGLE_CSE_API_KEY if you prefer one variable name:
# GOOGLE_API_KEY=
# SERPAPI_API_KEY=
# DISCOVERY_MIN_EXTRACTED_CHARS=300

# Optional
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
